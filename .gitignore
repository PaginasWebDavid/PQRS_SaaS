# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage/
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
~$*
*.pem
*.key
*.p12
*.pfx

# debug
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files and secrets
.env
.env.*
!.env.example
!.env.test.example
# archivos de configuracion de la base de datos de pruebas (nunca versionar credenciales)
.env.test

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees for isolated feature work
.worktrees/

# local tool state and generated caches
.impeccable/
__pycache__/
*.py[cod]

# Obsidian: configuracion y estado del vault, personal de cada equipo.
# Los apuntes en .md si se versionan; la carpeta de ajustes no.
.obsidian/

# local databases and backups
*.db
*.db-journal
*.dump
*.backup
/backups/

# Piezas de video: pesan decenas de MB y se quedarian en la historia de git
# para siempre. Se guardan en docs/marketing/comercial/ pero fuera del repo.
# Ver docs/marketing/comercial/LEEME.md
*.mp4
*.mov

# Skills instaladas por el gestor (543 archivos, ~12 MB de codigo de terceros).
# Se reinstalan desde skills-lock.json, que si va versionado: `npx skills install`.
.claude/skills/
.agents/skills/

# Musica con licencia de Uppbeat. La licencia cubre USARLA en el comercial, no
# redistribuir el archivo: este repositorio es publico.
assets/audio/

# Lienzo de Obsidian, no es parte del proyecto.
*.canvas
