// Intentos registrados para limitar fuerza bruta y abuso de correo.
//
// Vive en Postgres a proposito: en Vercel cada funcion puede correr en una
// instancia distinta y reiniciarse sola, asi que un contador en memoria deja
// pasar casi todo. Esta tabla es el unico estado compartido que ya existe.
//
// Cada fila es UN intento. La ventana se evalua contando filas recientes del
// mismo bucket, y las vencidas se borran en la misma operacion, de modo que
// ningun bucket crece sin limite.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
  @@index([createdAt])
}
