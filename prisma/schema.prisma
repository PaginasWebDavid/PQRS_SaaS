generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status      TenantStatus @default(ACTIVE)
  units       Int          @default(0)
  city        String?
  address     String?
  cancelledAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users         User[]
  memberships   TenantMembership[]
  pqrs          Pqrs[]
  fotos         PqrsFoto[]
  historial     HistorialPqrs[]
  subscription  Subscription?
  payments      Payment[]
  invitations   Invitation[]
  notifications Notification[]
  emailLogs     EmailLog[]
  billingNotificationOutbox BillingNotificationOutbox[]
  auditLogs     AuditLog[]
  supportTickets SupportTicket[]

  @@index([slug])
  @@index([status])
}

enum TenantStatus {
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  password              String
  name                  String
  role                  Role       @default(RESIDENTE)
  tenantId              String?
  tenant                Tenant?    @relation(fields: [tenantId], references: [id])
  bloque                Int?
  apto                  Int?
  haCorregidoUbicacion  Boolean    @default(false)
  emailVerified         DateTime?
  image                 String?
  phone                 String?
  isActive              Boolean    @default(true)
  onboardingCompletedAt DateTime?
  notifyNewPqrsEmail    Boolean    @default(true)
  bloqueAptoEditado     Boolean    @default(false)
  termsAcceptedAt       DateTime?
  privacyAcceptedAt     DateTime?
  termsVersion          String?
  privacyVersion        String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  pqrsCreated           Pqrs[]     @relation("CreatedBy")
  pqrsManaged           Pqrs[]     @relation("ManagedBy")
  auditLogs             AuditLog[]        @relation("AuditActor")
  invitedInvitations    Invitation[]      @relation("InvitationInvitedBy")
  notifications         Notification[]
  billingOutboxRecipients BillingNotificationOutbox[] @relation("BillingOutboxRecipient")
  updatedSettings       PlatformSetting[] @relation("PlatformSettingUpdatedBy")
  supportTicketsCreated   SupportTicket[] @relation("SupportTicketCreatedBy")
  supportTicketsResponded SupportTicket[] @relation("SupportTicketRespondedBy")
  sessions              Session[]
  accounts              Account[]
  memberships           TenantMembership[]

  @@index([tenantId])
  @@index([role])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@index([tenantId, bloque, apto])
}

// Fuente de verdad para acceso, rol y datos propios de cada conjunto.
// User.role/User.tenantId y los campos residenciales en User se conservan
// temporalmente para un despliegue aditivo y se eliminaran en una fase posterior.
model TenantMembership {
  id                    String   @id @default(cuid())
  userId                String
  tenantId              String
  role                  Role
  isActive              Boolean  @default(true)
  bloque                Int?
  apto                  Int?
  haCorregidoUbicacion  Boolean  @default(false)
  bloqueAptoEditado     Boolean  @default(false)
  onboardingCompletedAt DateTime?
  notifyNewPqrsEmail    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@index([userId, isActive])
  @@index([tenantId, isActive])
  @@index([tenantId, bloque, apto])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONSEJO
  RESIDENTE
}

model AuditLog {
  id           String      @id @default(cuid())
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       AuditAction
  targetType   String?
  targetId     String?
  resourceType String?
  resourceId   String?
  origin       String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([resourceType, resourceId])
}

enum AuditAction {
  TENANT_CREATED
  TENANT_SUSPENDED
  TENANT_REACTIVATED
  TENANT_CANCELLED
  TENANT_UPDATED
  TENANT_OVERDUE_RULES_APPLIED
  PLATFORM_SETTING_CHANGED
  PRICING_RULE_CHANGED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_RENEWED
  PAYMENT_SIMULATED
  MERCADO_PAGO_SUBSCRIPTION_CREATED
  MERCADO_PAGO_WEBHOOK_PROCESSED
  INVITATION_CREATED
  INVITATION_RESENT
  INVITATION_ACCEPTED
  INVITATION_CANCELLED
  INVITATION_EXPIRED
  NOTIFICATION_CREATED
  EMAIL_SENT
  EMAIL_FAILED
  PQRS_CREATED
  PQRS_UPDATED
  PQRS_CLOSED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  ONBOARDING_COMPLETED
  PROFILE_UPDATED
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_RESPONDED
  SUPPORT_TICKET_CLOSED
  REPORT_GENERATED
  REPORT_EXPORTED
  SUBSCRIPTION_AUTO_RENEW_DISABLED
  SUBSCRIPTION_AUTO_RENEW_ENABLED
  SUBSCRIPTION_PAYMENT_FAILED
  PAYMENT_RECONCILED
}

enum SupportTicketStatus {
  ABIERTA
  RESPONDIDA
  CERRADA
}

enum SupportTicketCategory {
  TECNICO
  FACTURACION
  CUENTA
  OTRO
}

model SupportTicket {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdBy         User                  @relation("SupportTicketCreatedBy", fields: [createdByUserId], references: [id])
  subject           String
  message           String                @db.Text
  category          SupportTicketCategory @default(OTRO)
  status            SupportTicketStatus   @default(ABIERTA)
  response          String?               @db.Text
  respondedAt       DateTime?
  respondedByUserId String?
  respondedBy       User?                 @relation("SupportTicketRespondedBy", fields: [respondedByUserId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdByUserId])
}

model PricingRule {
  id        String   @id @default(cuid())
  minUnits  Int
  maxUnits  Int?
  priceCents Int
  currency  String   @default("COP")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([minUnits, maxUnits])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  status             SubscriptionStatus @default(PENDING_PAYMENT)
  autoRenew          Boolean            @default(true)
  unitsSnapshot            Int
  priceCents               Int
  currency                 String             @default("COP")
  pendingUnitsSnapshot     Int?
  pendingPriceCents        Int?
  pendingCurrency          String?
  pendingPriceEffectiveAt  DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  graceEndsAt                 DateTime?
  mercadoPagoPreapprovalId    String?            @unique
  mercadoPagoInitPoint        String?            @db.Text
  mercadoPagoStatus           String?
  lastWebhookAt               DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  payments           Payment[]
  billingNotificationOutbox BillingNotificationOutbox[]

  @@index([tenantId, status])
  @@index([currentPeriodEnd])
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model Payment {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  subscriptionId    String
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id])
  amountCents       Int
  currency          String          @default("COP")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(SIMULATED)
  dueDate           DateTime
  paidAt            DateTime?
  periodStart       DateTime
  periodEnd         DateTime
  externalReference    String?
  mercadoPagoPaymentId String?         @unique
  rawStatus            String?
  // Marcador atomico de idempotencia del efecto economico: se fija (via update
  // condicional WHERE approvedEffectAppliedAt IS NULL) la primera vez que un pago
  // APPROVED extiende el periodo. Un APPROVED repetido lo encuentra ya fijado y
  // no vuelve a extender. No confundir con `status` (que puede transicionar
  // PENDING -> APPROVED de forma legitima).
  approvedEffectAppliedAt DateTime?
  // Cuarentena de pagos historicos: los pagos MERCADO_PAGO+APPROVED que existian
  // antes de la migracion de idempotencia se marcan =true. El handler NUNCA reclama
  // el efecto de un pago en cuarentena (no puede extender por replay historico);
  // solo la reconciliacion manual (scripts/reconcile-historical-payment-effects.ts)
  // lo baja a false tras verificar evidencia. Los pagos nuevos nacen en false.
  approvedEffectReconciliationRequired Boolean @default(false)
  createdAt            DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status, dueDate])
  @@index([tenantId, status, dueDate])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProvider {
  SIMULATED
  MERCADO_PAGO
}

// Ledger de ENTREGAS de webhook (no es la garantia economica). Registra cada
// solicitud entrante y su resultado para trazabilidad. La idempotencia del efecto
// economico vive en Payment.approvedEffectAppliedAt, no aqui. tenantId/subscriptionId
// se guardan como texto plano (sin FK) para mantener el ledger desacoplado y aditivo.
model WebhookEvent {
  id             String             @id @default(cuid())
  provider       String
  topic          String
  dataId         String
  requestId      String?
  rawStatus      String?
  tenantId       String?
  subscriptionId String?
  result         WebhookEventResult @default(RECEIVED)
  errorCode      String?
  metadata       Json?
  receivedAt     DateTime           @default(now())
  processedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([provider, topic])
  @@index([dataId])
  @@index([tenantId])
  @@index([receivedAt])
}

enum WebhookEventResult {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  FAILED
  ENTITY_NOT_FOUND
  UNSUPPORTED_TOPIC
  // Pago historico en cuarentena: no se aplico efecto; requiere reconciliacion manual.
  RECONCILIATION_REQUIRED
}

model Pqrs {
  id                            String          @id @default(cuid())
  numero                        Int             @unique @default(autoincrement())
  tenantId                      String
  tenant                        Tenant          @relation(fields: [tenantId], references: [id])
  medio                         Medio           @default(PLATAFORMA_WEB)
  fechaRecibido                 DateTime
  mes                           String
  bloque                        Int
  apto                          Int
  nombreResidente               String
  tipoPqrs                      TipoPqrs?
  titulo                        String?
  asunto                        String?
  subAsunto                     String?
  prioridad                     Prioridad       @default(MEDIA)
  descripcion                   String          @db.Text
  editadoPorResidente           Boolean         @default(false)
  numeroRadicacion              String?         @unique

  // Gestion por asistente/admin
  fechaPrimerContacto           DateTime?
  tiempoRespuestaPrimerContacto Int?
  notaPrimerContacto            String?         @db.Text
  accionTomada                  String?         @db.Text
  estado                        Estado          @default(EN_ESPERA)
  evidenciaCierre               String?         @db.Text
  evidenciaArchivoData          String?         @db.Text
  evidenciaArchivoUrl           String?         @db.Text
  evidenciaArchivoPath          String?
  evidenciaArchivoNombre        String?
  evidenciaArchivoTipo          String?
  evidenciaArchivoSize          Int?
  fechaCierre                   DateTime?
  tiempoRespuestaCierre         Int?

  // Fases de gestion (solo admin, no visible para residente)
  faseActual                    Int?            // 1-5, null = sin fase asignada
  faseTipo                      String?         // "INSUMOS" (Fase II) o "PROVEEDOR" (Fase III)
  fase1Inicio                   DateTime?       // Inspeccion de Campo
  fase1Nota                     String?         @db.Text
  fase2Inicio                   DateTime?       // Adquisicion de insumos
  fase2Nota                     String?         @db.Text
  fase3Inicio                   DateTime?       // Firma contrato proveedor
  fase3Nota                     String?         @db.Text
  fase4Inicio                   DateTime?       // Ejecucion
  fase4Nota                     String?         @db.Text
  fase5Inicio                   DateTime?       // Terminado
  queSeHizoParaCerrar           String?         @db.Text  // Obligatorio si se cierra sin completar todas las fases

  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creadoPor       User?     @relation("CreatedBy", fields: [creadoPorId], references: [id])
  creadoPorId     String?
  gestionadoPor   User?     @relation("ManagedBy", fields: [gestionadoPorId], references: [id])
  gestionadoPorId String?

  // Trazabilidad
  historial HistorialPqrs[]
  fotos     PqrsFoto[]

  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([tenantId, fechaRecibido])
  @@index([tenantId, numero])
  @@index([tenantId, mes])
  @@index([tenantId, asunto])
  @@index([tenantId, bloque, apto])
  @@index([tenantId, creadoPorId])
}

enum Medio {
  PLATAFORMA_WEB
}

enum TipoPqrs {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
}

enum Estado {
  EN_ESPERA
  EN_PROGRESO
  TERMINADO
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

model PqrsFoto {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  pqrsId      String
  pqrs        Pqrs     @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  data        String?  @db.Text
  url         String?  @db.Text
  storagePath String?
  nombre      String
  tipo        String
  size        Int?
  orden       Int
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([pqrsId])
  @@index([tenantId, createdAt])
}

model HistorialPqrs {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  pqrsId        String
  pqrs          Pqrs     @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  estadoAntes   Estado?
  estadoDespues Estado
  nota          String?
  creadoAt      DateTime @default(now())

  @@index([tenantId])
  @@index([pqrsId])
  @@index([tenantId, creadoAt])
  @@index([tenantId, pqrsId, creadoAt])
}


model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String?
  invitedBy   User?            @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([expiresAt])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Notification {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  title        String
  message      String    @db.Text
  resourceType String?
  resourceId   String?
  dedupeKey    String?   @unique @db.VarChar(255)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId, readAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model EmailLog {
  id                String         @id @default(cuid())
  tenantId          String?
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  recipient         String
  template          String
  provider          String         @default("RESEND")
  providerMessageId String?
  dedupeKey         String?        @unique @db.VarChar(255)
  outboxId          String?        @unique
  billingOutbox     BillingNotificationOutbox? @relation(fields: [outboxId], references: [id], onDelete: SetNull, map: "EmailLog_outboxId_fkey")
  status            EmailLogStatus
  errorMessage      String?        @db.Text
  attemptCount      Int            @default(0)
  lastAttemptAt     DateTime?
  lastErrorCode     String?        @db.VarChar(255)
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([tenantId])
  @@index([recipient])
  @@index([template])
  @@index([status])
  @@index([createdAt])
}

enum EmailLogStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  FAILED_RETRYABLE
  FAILED_FINAL
  DELIVERY_UNKNOWN
  SKIPPED
}

model BillingNotificationOutbox {
  id                       String                  @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "BillingOutbox_tenant_fkey")
  subscriptionId           String
  subscription             Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, map: "BillingOutbox_subscription_fkey")
  recipientUserId          String?
  recipientUser            User?                   @relation("BillingOutboxRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull, map: "BillingOutbox_recipient_fkey")
  channel                  BillingOutboxChannel
  eventType                BillingOutboxEventType
  dedupeKey                String                  @unique @db.VarChar(255)
  status                   BillingOutboxStatus     @default(PENDING)
  attemptCount             Int                     @default(0)
  nextAttemptAt            DateTime                @default(now())
  lockedAt                 DateTime?
  processingStartedAt      DateTime?
  providerAttemptStartedAt DateTime?
  processedAt              DateTime?
  lastErrorCode            String?                 @db.VarChar(255)
  payload                  Json
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  attempts                 BillingOutboxAttempt[]
  emailLog                 EmailLog?

  @@index([status, nextAttemptAt, createdAt, id], map: "BillingOutbox_dispatch_idx")
  @@index([tenantId], map: "BillingOutbox_tenant_idx")
  @@index([subscriptionId], map: "BillingOutbox_subscription_idx")
  @@index([recipientUserId], map: "BillingOutbox_recipient_idx")
}

model BillingOutboxAttempt {
  id                String                    @id @default(cuid())
  outboxId          String
  outbox            BillingNotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade, map: "BillingOutboxAttempt_outbox_fkey")
  attemptNumber     Int
  status            BillingOutboxAttemptStatus
  providerMessageId String?
  errorCode         String?                   @db.VarChar(255)
  startedAt         DateTime                  @default(now())
  finishedAt        DateTime?

  @@unique([outboxId, attemptNumber], map: "BillingOutboxAttempt_outbox_attempt_key")
  @@index([outboxId], map: "BillingOutboxAttempt_outbox_idx")
}

enum BillingOutboxChannel {
  IN_APP
  EMAIL
}

enum BillingOutboxEventType {
  BILLING_GRACE_STARTED
  BILLING_SUSPENDED
}

enum BillingOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
  DELIVERY_UNKNOWN
}

enum BillingOutboxAttemptStatus {
  STARTED
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
  DELIVERY_UNKNOWN
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isSecret])
  @@index([updatedById])
}
// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

