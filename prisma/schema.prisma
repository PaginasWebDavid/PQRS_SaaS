// Ledger de ENTREGAS de webhook (no es la garantia economica). Registra cada
// solicitud entrante y su resultado para trazabilidad. La idempotencia del efecto
// economico vive en Payment.approvedEffectAppliedAt, no aqui. tenantId/subscriptionId
// se guardan como texto plano (sin FK) para mantener el ledger desacoplado y aditivo.
model WebhookEvent {
  id             String             @id @default(cuid())
  provider       String
  topic          String
  dataId         String
  requestId      String?
  rawStatus      String?
  tenantId       String?
  subscriptionId String?
  result         WebhookEventResult @default(RECEIVED)
  errorCode      String?
  metadata       Json?
  receivedAt     DateTime           @default(now())
  processedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([provider, topic])
  @@index([dataId])
  @@index([tenantId])
  @@index([receivedAt])
}

enum WebhookEventResult {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  FAILED
  ENTITY_NOT_FOUND
  UNSUPPORTED_TOPIC
  // Pago historico en cuarentena: no se aplico efecto; requiere reconciliacion manual.
  RECONCILIATION_REQUIRED
}

model Pqrs {
  id                  String        @id @default(cuid())
  numero              Int           @unique @default(autoincrement())
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  medio               Medio         @default(PLATAFORMA_WEB)
  fechaRecibido       DateTime
  mes                 String
  bloque              Int
  apto                Int
  nombreResidente     String
  tipoPqrs            TipoPqrs?
  titulo              String?
  asunto              String?
  subAsunto           String?
  // Relacion y etiqueta historica aditivas. asunto/subAsunto/tipoPqrs se
  // conservan temporalmente para lectores legacy y migracion segura.
  categoryId          String?
  category            PqrsCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categorySnapshot    String?
  prioridad           Prioridad     @default(MEDIA)
  descripcion         String        @db.Text
  editadoPorResidente Boolean       @default(false)
  numeroRadicacion    String?       @unique

  // Gestion por asistente/admin
  fechaPrimerContacto               DateTime?
  tiempoRespuestaPrimerContacto     Int?
  notaPrimerContacto                String?   @db.Text
  accionTomada                      String?   @db.Text
  estado                            Estado    @default(EN_ESPERA)
  evidenciaCierre                   String?   @db.Text
  evidenciaArchivoData              String?   @db.Text
  evidenciaArchivoUrl               String?   @db.Text
  evidenciaArchivoPath              String?
  evidenciaArchivoNombre            String?
  evidenciaArchivoTipo              String?
  evidenciaArchivoSize              Int?
  evidenciaArchivoRetiradaAt        DateTime?
  evidenciaArchivoRetiradaPorId     String?
  evidenciaArchivoRetiradaPor       User?     @relation("PqrsEvidenceWithdrawnBy", fields: [evidenciaArchivoRetiradaPorId], references: [id], onDelete: SetNull)
  evidenciaArchivoRetiroMotivo      String?
  // Tombstone privado: conserva el path de Storage retirado hasta que la limpieza
  // fisica confirme exito. Nunca se selecciona fuera de pqrs-evidence.service.ts.
  evidenciaArchivoRetiroStoragePath String?
  fechaCierre                       DateTime?
  tiempoRespuestaCierre             Int?

  // Snapshot inmutable derivado de PqrsCategory al crear la PQRS.
  // Cambiar la categoria despues no altera casos historicos.
  workflowType PqrsWorkflowType @default(MAINTENANCE)

  // Fases de gestion (solo admin, no visible para residente)
  faseActual          Int? // 1-5, null = sin fase asignada
  faseTipo            String? // "INSUMOS" (Fase II) o "PROVEEDOR" (Fase III)
  fase1Inicio         DateTime? // Inspeccion de Campo
  fase1Nota           String?   @db.Text
  fase2Inicio         DateTime? // Adquisicion de insumos
  fase2Nota           String?   @db.Text
  fase3Inicio         DateTime? // Firma contrato proveedor
  fase3Nota           String?   @db.Text
  fase4Inicio         DateTime? // Ejecucion
  fase4Nota           String?   @db.Text
  fase5Inicio         DateTime? // Terminado
  queSeHizoParaCerrar String?   @db.Text // Obligatorio si se cierra sin completar todas las fases

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  creadoPor       User?    @relation("CreatedBy", fields: [creadoPorId], references: [id])
  creadoPorId     String?
  gestionadoPor   User?    @relation("ManagedBy", fields: [gestionadoPorId], references: [id])
  gestionadoPorId String?

  // Trazabilidad
  historial   HistorialPqrs[]
  fotos       PqrsFoto[]
  corrections PqrsCorrection[]

  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([tenantId, fechaRecibido])
  @@index([tenantId, numero])
  @@index([tenantId, mes])
  @@index([tenantId, asunto])
  @@index([tenantId, categoryId])
  @@index([tenantId, bloque, apto])
  @@index([tenantId, creadoPorId])
}

