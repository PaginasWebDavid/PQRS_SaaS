generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  status           TenantStatus     @default(ACTIVE)
  units            Int              @default(0)
  city             String?
  address          String?
  cancelledAt      DateTime?
  // Configuracion legacy conservada durante la migracion aditiva. Las PQRS nuevas
  // derivan workflowType de PqrsCategory; este valor solo respalda lectores antiguos.
  pqrsWorkflowType PqrsWorkflowType @default(MAINTENANCE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users                     User[]
  memberships               TenantMembership[]
  pqrs                      Pqrs[]
  pqrsCategories            PqrsCategory[]
  pqrsCorrections           PqrsCorrection[]
  fotos                     PqrsFoto[]
  historial                 HistorialPqrs[]
  subscription              Subscription?
  payments                  Payment[]
  wompiPaymentMethods       WompiPaymentMethod[]
  invitations               Invitation[]
  notifications             Notification[]
  emailLogs                 EmailLog[]
  billingNotificationOutbox BillingNotificationOutbox[]
  auditLogs                 AuditLog[]
  supportTickets            SupportTicket[]
  commonAreas               CommonArea[]
  reservations              Reservation[]
  commonAreaBlocks          CommonAreaBlock[]
  residentUnits             ResidentUnit[]
  residentCharges           ResidentCharge[]
  residentPayments          ResidentPayment[]
  paymentReceipts           PaymentReceipt[]
  paymentImportBatches      PaymentImportBatch[]
  commercialProfile         TenantCommercialProfile?
  featureEntitlements       TenantFeatureEntitlement[]
  commercialOperations      CommercialOperation[]

  @@index([slug])
  @@index([status])
}

enum PqrsWorkflowType {
  SIMPLE
  MAINTENANCE
}

enum TenantStatus {
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model User {
  id                           String                      @id @default(cuid())
  email                        String                      @unique
  password                     String
  name                         String
  role                         Role                        @default(RESIDENTE)
  tenantId                     String?
  tenant                       Tenant?                     @relation(fields: [tenantId], references: [id])
  bloque                       Int?
  apto                         Int?
  haCorregidoUbicacion         Boolean                     @default(false)
  emailVerified                DateTime?
  image                        String?
  phone                        String?
  isActive                     Boolean                     @default(true)
  sessionVersion               Int                         @default(0)
  passwordChangedAt            DateTime?
  onboardingCompletedAt        DateTime?
  notifyNewPqrsEmail           Boolean                     @default(true)
  bloqueAptoEditado            Boolean                     @default(false)
  termsAcceptedAt              DateTime?
  privacyAcceptedAt            DateTime?
  termsVersion                 String?
  privacyVersion               String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  pqrsCreated                  Pqrs[]                      @relation("CreatedBy")
  pqrsManaged                  Pqrs[]                      @relation("ManagedBy")
  pqrsCategoriesCreated        PqrsCategory[]              @relation("PqrsCategoryCreatedBy")
  pqrsCorrections              PqrsCorrection[]            @relation("PqrsCorrectionActor")
  pqrsEvidenceWithdrawals      Pqrs[]                      @relation("PqrsEvidenceWithdrawnBy")
  pqrsPhotoWithdrawals         PqrsFoto[]                  @relation("PqrsPhotoWithdrawnBy")
  auditLogs                    AuditLog[]                  @relation("AuditActor")
  invitedInvitations           Invitation[]                @relation("InvitationInvitedBy")
  notifications                Notification[]
  billingOutboxRecipients      BillingNotificationOutbox[] @relation("BillingOutboxRecipient")
  updatedSettings              PlatformSetting[]           @relation("PlatformSettingUpdatedBy")
  supportTicketsCreated        SupportTicket[]             @relation("SupportTicketCreatedBy")
  supportTicketsResponded      SupportTicket[]             @relation("SupportTicketRespondedBy")
  sessions                     Session[]
  accounts                     Account[]
  memberships                  TenantMembership[]
  reservationsCreated          Reservation[]               @relation("ReservationCreatedBy")
  reservationsReviewed         Reservation[]               @relation("ReservationReviewedBy")
  reservationsCancelled        Reservation[]               @relation("ReservationCancelledBy")
  commonAreaBlocksCreated      CommonAreaBlock[]           @relation("CommonAreaBlockCreatedBy")
  residentChargesCreated       ResidentCharge[]            @relation("ResidentChargeCreatedBy")
  residentPaymentsRecorded     ResidentPayment[]           @relation("ResidentPaymentRecordedBy")
  residentPaymentsReversed     ResidentPayment[]           @relation("ResidentPaymentReversedBy")
  paymentReceiptsUploaded      PaymentReceipt[]            @relation("PaymentReceiptUploadedBy")
  paymentReceiptsReviewed      PaymentReceipt[]            @relation("PaymentReceiptReviewedBy")
  paymentImportBatchesUploaded PaymentImportBatch[]        @relation("PaymentImportBatchUploadedBy")
  wompiPaymentMethodsCreated   WompiPaymentMethod[]        @relation("WompiPaymentMethodCreatedBy")

  @@index([tenantId])
  @@index([role])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@index([tenantId, bloque, apto])
}

// Fuente de verdad para acceso, rol y datos propios de cada conjunto.
// User.role/User.tenantId y los campos residenciales en User se conservan
// temporalmente para un despliegue aditivo y se eliminaran en una fase posterior.
model TenantMembership {
  id                    String    @id @default(cuid())
  userId                String
  tenantId              String
  role                  Role
  isActive              Boolean   @default(true)
  bloque                Int?
  apto                  Int?
  haCorregidoUbicacion  Boolean   @default(false)
  bloqueAptoEditado     Boolean   @default(false)
  onboardingCompletedAt DateTime?
  notifyNewPqrsEmail    Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  paymentReceipts PaymentReceipt[]

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@index([userId, isActive])
  @@index([tenantId, isActive])
  @@index([tenantId, bloque, apto])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONSEJO
  RESIDENTE
}

model AuditLog {
  id           String      @id @default(cuid())
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       AuditAction
  targetType   String?
  targetId     String?
  resourceType String?
  resourceId   String?
  origin       String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([resourceType, resourceId])
}

enum AuditAction {
  TENANT_CREATED
  TENANT_SUSPENDED
  TENANT_REACTIVATED
  TENANT_CANCELLED
  TENANT_UPDATED
  TENANT_OVERDUE_RULES_APPLIED
  PLATFORM_SETTING_CHANGED
  PRICING_RULE_CHANGED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_RENEWED
  PAYMENT_SIMULATED
  MERCADO_PAGO_SUBSCRIPTION_CREATED
  MERCADO_PAGO_WEBHOOK_PROCESSED
  WOMPI_CHECKOUT_CREATED
  WOMPI_WEBHOOK_PROCESSED
  WOMPI_PAYMENT_METHOD_CREATED
  WOMPI_PAYMENT_METHOD_REVOKED
  WOMPI_AUTOMATIC_CHARGE_CREATED
  WOMPI_AUTOMATIC_CHARGE_FAILED
  INVITATION_CREATED
  INVITATION_RESENT
  INVITATION_ACCEPTED
  INVITATION_CANCELLED
  INVITATION_EXPIRED
  NOTIFICATION_CREATED
  EMAIL_SENT
  EMAIL_FAILED
  PQRS_CREATED
  PQRS_UPDATED
  PQRS_CLOSED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  ONBOARDING_COMPLETED
  PROFILE_UPDATED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  AVATAR_UPDATED
  AVATAR_REMOVED
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_RESPONDED
  SUPPORT_TICKET_CLOSED
  REPORT_GENERATED
  REPORT_EXPORTED
  SUBSCRIPTION_AUTO_RENEW_DISABLED
  SUBSCRIPTION_AUTO_RENEW_ENABLED
  SUBSCRIPTION_PAYMENT_FAILED
  PAYMENT_RECONCILED
  RESERVATION_CREATED
  RESERVATION_APPROVED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
  COMMON_AREA_CREATED
  COMMON_AREA_UPDATED
  COMMON_AREA_BLOCK_CREATED
  PAYMENT_IMPORT_BATCH_COMPLETED
  RESIDENT_CHARGE_CREATED
  RESIDENT_CHARGE_CANCELLED
  PAYMENT_RECEIPT_UPLOADED
  PAYMENT_RECEIPT_APPROVED
  PAYMENT_RECEIPT_REJECTED
  PAYMENT_RECEIPT_WITHDRAWN
  RESIDENT_PAYMENT_RECORDED
  RESIDENT_PAYMENT_REVERSED
  COMMERCIAL_PROFILE_CHANGED
  PILOT_PAYMENT_CONFIRMED
  PILOT_STARTED
  PILOT_EVALUATION_STARTED
  PILOT_CONVERTED
  TENANT_FEATURE_CHANGED
}

enum SupportTicketStatus {
  ABIERTA
  RESPONDIDA
  CERRADA
}

enum SupportTicketCategory {
  TECNICO
  FACTURACION
  CUENTA
  OTRO
  // Categorias vigentes (Fase R1): reemplazan las de arriba para tickets nuevos.
  // Las anteriores se conservan solo por compatibilidad con filas historicas;
  // Postgres no permite eliminar valores de un enum sin recrearlo.
  TECHNICAL
  ACCESS
  PRIVACY_SECURITY
  BILLING
}

model SupportTicket {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdBy         User                  @relation("SupportTicketCreatedBy", fields: [createdByUserId], references: [id])
  subject           String
  message           String                @db.Text
  category          SupportTicketCategory @default(OTRO)
  status            SupportTicketStatus   @default(ABIERTA)
  response          String?               @db.Text
  respondedAt       DateTime?
  respondedByUserId String?
  respondedBy       User?                 @relation("SupportTicketRespondedBy", fields: [respondedByUserId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdByUserId])
}

// Reservas y zonas comunes. La instancia opera en una sola zona horaria de
// producto (America/Bogota, ver src/domains/reservations/reservation-time.ts);
// no existe columna de timezone por tenant a proposito, para no ampliar el
// alcance de esta fase. openingTime/closingTime son "HH:mm" interpretadas en
// esa zona horaria. blockedWeekdays usa la convencion de JS Date.getDay():
// 0=domingo .. 6=sabado, evaluado tambien en esa zona horaria.
model CommonArea {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  description            String?  @db.Text
  isActive               Boolean  @default(true)
  requiresApproval       Boolean  @default(true)
  minDurationMinutes     Int      @default(30)
  maxDurationMinutes     Int      @default(120)
  maxReservationsPerWeek Int      @default(2)
  openingTime            String
  closingTime            String
  blockedWeekdays        Int[]    @default([])
  rules                  String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  reservations Reservation[]
  blocks       CommonAreaBlock[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// La no-superposicion de PENDING/APPROVED para una misma zona la garantiza,
// ademas de la logica de aplicacion, un EXCLUDE constraint de PostgreSQL creado
// a mano en la migracion (btree_gist sobre commonAreaId + tsrange(startAt,
// endAt, '[)'), filtrado por status). Ver migration.sql de esta fase.
model Reservation {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commonAreaId      String
  commonArea        CommonArea        @relation(fields: [commonAreaId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        TenantMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdBy         User              @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id])
  startAt           DateTime
  endAt             DateTime
  status            ReservationStatus @default(PENDING)
  notes             String?           @db.Text
  reviewedByUserId  String?
  reviewedBy        User?             @relation("ReservationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  rejectionReason   String?           @db.Text
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?             @relation("ReservationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([tenantId, commonAreaId, status, startAt])
  @@index([tenantId, membershipId, status])
  @@index([commonAreaId, status, startAt, endAt])
}

model CommonAreaBlock {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commonAreaId    String
  commonArea      CommonArea @relation(fields: [commonAreaId], references: [id], onDelete: Cascade)
  startAt         DateTime
  endAt           DateTime
  reason          String
  createdByUserId String
  createdBy       User       @relation("CommonAreaBlockCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime   @default(now())

  @@index([tenantId, commonAreaId, startAt, endAt])
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum ChargeSource {
  MANUAL
  IMPORT
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ResidentPaymentStatus {
  CONFIRMED
  REVERSED
}

enum PaymentSource {
  MANUAL
  RECEIPT_APPROVAL
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// Pagos de residentes (cuotas de administracion), independientes del billing
// del SaaS (Payment/Subscription = pago del TENANT a la plataforma, mas
// arriba en este archivo). El sistema no tiene un modelo estable de
// apartamento/unidad: bloque/apto viven como Int? sueltos en
// TenantMembership. ResidentUnit normaliza esa dimension (tenantId+bloque+
// apto) para que obligaciones y pagos sobrevivan a cambios de membresia
// (mudanzas, nuevo residente en el mismo apto), sin duplicar esos enteros en
// cada fila financiera.
model ResidentUnit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bloque    Int
  apto      Int
  createdAt DateTime @default(now())

  charges  ResidentCharge[]
  payments ResidentPayment[]

  @@unique([tenantId, bloque, apto])
  @@index([tenantId])
}

// Obligacion o cuota (estado de cuenta). amountCents/paidCents en centavos de
// COP (Int), consistente con Payment.amountCents/Subscription.priceCents mas
// arriba en este archivo (evita introducir Decimal como un tipo de dato
// nuevo y aislado; Int en centavos ya esta libre de error de coma flotante).
// paidCents es la unica fuente de verdad del saldo abonado: solo se
// actualiza dentro de la misma transaccion que crea/revierte un
// ResidentPayment, bajo el advisory lock de la obligacion (ver
// resident-payment.service.ts). status se deriva de amountCents/paidCents en
// ese mismo punto, nunca de forma independiente.
model ResidentCharge {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId          String
  unit            ResidentUnit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  period          String
  concept         String
  amountCents     Int
  paidCents       Int                 @default(0)
  dueDate         DateTime
  status          ChargeStatus        @default(PENDING)
  source          ChargeSource        @default(MANUAL)
  importBatchId   String?
  importBatch     PaymentImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdBy       User?               @relation("ResidentChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  payments ResidentPayment[]
  receipts PaymentReceipt[]

  // Clave idempotente de importacion: reintentar el mismo archivo, o dos
  // importaciones concurrentes con una fila equivalente, no duplica la
  // obligacion (se cuenta como fila duplicada, ver PaymentImportBatch).
  @@unique([tenantId, unitId, period, concept])
  @@index([tenantId, period])
  @@index([tenantId, unitId])
  @@index([tenantId, status])
  @@index([importBatchId])
}

// Pago/movimiento confirmado contra una obligacion. Se crea EXCLUSIVAMENTE
// por aprobacion de un comprobante o por registro administrativo manual --
// nunca directamente desde la importacion Excel (que solo crea/actualiza
// obligaciones), para mantener una unica via auditable de dinero entrando al
// sistema. reversedAt!=null marca una reversion/correccion; la fila nunca se
// borra (historial financiero completo).
model ResidentPayment {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chargeId         String
  charge           ResidentCharge        @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  unitId           String
  unit             ResidentUnit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  amountCents      Int
  paidAt           DateTime
  reference        String?
  status           ResidentPaymentStatus @default(CONFIRMED)
  source           PaymentSource
  recordedByUserId String
  recordedBy       User                  @relation("ResidentPaymentRecordedBy", fields: [recordedByUserId], references: [id])
  reversedAt       DateTime?
  reversedByUserId String?
  reversedBy       User?                 @relation("ResidentPaymentReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversalReason   String?               @db.Text
  receiptId        String?               @unique
  receipt          PaymentReceipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([tenantId, unitId])
  @@index([tenantId, chargeId])
  @@index([tenantId, status])
}

// Comprobante de pago cargado por el residente. Privado: el archivo vive en
// Supabase Storage bajo el path derivado en servidor (folder "comprobantes",
// ver src/lib/storage.ts), nunca en una URL publica. declaredAmountCents es
// meramente informativo (lo que el residente dice haber pagado); el monto
// que realmente se aplica al saldo lo fija el ADMIN al aprobar.
model PaymentReceipt {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chargeId            String
  charge              ResidentCharge   @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  membershipId        String
  membership          TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  uploadedByUserId    String
  uploadedBy          User             @relation("PaymentReceiptUploadedBy", fields: [uploadedByUserId], references: [id])
  storagePath         String
  originalFileName    String
  mimeType            String
  sizeBytes           Int
  declaredAmountCents Int?
  status              ReceiptStatus    @default(PENDING)
  reviewedByUserId    String?
  reviewedBy          User?            @relation("PaymentReceiptReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  rejectionReason     String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  payment ResidentPayment?

  @@index([tenantId, status])
  @@index([tenantId, membershipId])
  @@index([chargeId])
}

// Lote de importacion Excel de obligaciones. errorSummary guarda una lista
// acotada de errores por fila ya saneados (numero de fila + mensaje
// publico), nunca SQL/stack/contenido crudo del archivo.
model PaymentImportBatch {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedBy       User              @relation("PaymentImportBatchUploadedBy", fields: [uploadedByUserId], references: [id])
  fileName         String
  status           ImportBatchStatus @default(PROCESSING)
  totalRows        Int               @default(0)
  validRows        Int               @default(0)
  invalidRows      Int               @default(0)
  createdRows      Int               @default(0)
  duplicateRows    Int               @default(0)
  errorSummary     Json?
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  charges ResidentCharge[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model PricingRule {
  id         String          @id @default(cuid())
  type       PricingRuleType @default(MONTHLY)
  minUnits   Int
  maxUnits   Int?
  priceCents Int
  currency   String          @default("COP")
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([type, isActive])
  @@index([type, minUnits, maxUnits])
}

enum PricingRuleType {
  MONTHLY
  PILOT
}

model Subscription {
  id                        String                      @id @default(cuid())
  tenantId                  String                      @unique
  tenant                    Tenant                      @relation(fields: [tenantId], references: [id])
  status                    SubscriptionStatus          @default(PENDING_PAYMENT)
  autoRenew                 Boolean                     @default(true)
  unitsSnapshot             Int
  priceCents                Int
  currency                  String                      @default("COP")
  pendingUnitsSnapshot      Int?
  pendingPriceCents         Int?
  pendingCurrency           String?
  pendingPriceEffectiveAt   DateTime?
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  trialEndsAt               DateTime?
  graceEndsAt               DateTime?
  mercadoPagoPreapprovalId  String?                     @unique
  mercadoPagoInitPoint      String?                     @db.Text
  mercadoPagoStatus         String?
  lastWebhookAt             DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  payments                  Payment[]
  billingNotificationOutbox BillingNotificationOutbox[]

  @@index([tenantId, status])
  @@index([currentPeriodEnd])
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model Payment {
  id                                   String              @id @default(cuid())
  tenantId                             String
  tenant                               Tenant              @relation(fields: [tenantId], references: [id])
  subscriptionId                       String
  subscription                         Subscription        @relation(fields: [subscriptionId], references: [id])
  amountCents                          Int
  concept                              PaymentConcept      @default(SUBSCRIPTION_MONTHLY)
  listAmountCents                      Int?
  discountBps                          Int                 @default(0)
  currency                             String              @default("COP")
  status                               PaymentStatus       @default(PENDING)
  provider                             PaymentProvider     @default(SIMULATED)
  dueDate                              DateTime
  paidAt                               DateTime?
  periodStart                          DateTime
  periodEnd                            DateTime
  externalReference                    String?
  mercadoPagoPaymentId                 String?             @unique
  wompiTransactionId                   String?             @unique
  wompiPaymentMethodId                 String?
  wompiPaymentMethod                   WompiPaymentMethod? @relation(fields: [wompiPaymentMethodId], references: [id], onDelete: SetNull)
  rawStatus                            String?
  operationId                          String?
  requestHash                          String?
  recordedByUserId                     String?
  manualReference                      String?
  // Marcador atomico de idempotencia del efecto economico: se fija (via update
  // condicional WHERE approvedEffectAppliedAt IS NULL) la primera vez que un pago
  // APPROVED extiende el periodo. Un APPROVED repetido lo encuentra ya fijado y
  // no vuelve a extender. No confundir con `status` (que puede transicionar
  // PENDING -> APPROVED de forma legitima).
  approvedEffectAppliedAt              DateTime?
  // Cuarentena de pagos historicos: los pagos MERCADO_PAGO+APPROVED que existian
  // antes de la migracion de idempotencia se marcan =true. El handler NUNCA reclama
  // el efecto de un pago en cuarentena (no puede extender por replay historico);
  // solo la reconciliacion manual (scripts/reconcile-historical-payment-effects.ts)
  // lo baja a false tras verificar evidencia. Los pagos nuevos nacen en false.
  approvedEffectReconciliationRequired Boolean             @default(false)
  createdAt                            DateTime            @default(now())
  updatedAt                            DateTime            @updatedAt

  @@unique([tenantId, operationId])
  @@index([tenantId])
  @@index([subscriptionId])
  @@index([tenantId, concept, status])
  @@index([status, dueDate])
  @@index([tenantId, status, dueDate])
  @@index([wompiPaymentMethodId])
  @@index([createdAt])
}

